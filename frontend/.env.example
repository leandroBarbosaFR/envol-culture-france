# Copiez ce fichier en `.env.local` (non versionné) pour le développement local.
# Les mêmes variables sont définies sur Vercel (projet envol-culture-france, équipe 1367-studio).
NEXT_PUBLIC_SANITY_PROJECT_ID=yrndrbta
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Origine publique du site — sert aux URL canoniques, aux images Open Graph,
# à robots.txt et au sitemap. Sans elle, robots.txt bloque toute indexation
# (protection des previews). Sur Vercel, à défaut, l'URL de production est utilisée.
NEXT_PUBLIC_SITE_URL=https://www.envol-rlb-asso.fr

# ── Formulaire de contact (SMTP) ─────────────────────────────────────────────
# Sans ces variables le formulaire refuse l'envoi et affiche un repli
# « écrivez-nous directement » ; le site continue de fonctionner.
# MAIL_PASS doit être un mot de passe d'application Google
# (myaccount.google.com/apppasswords, validation en deux étapes requise) :
# le mot de passe du compte est refusé par Gmail en SMTP.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=associationenvol13830@gmail.com
MAIL_PASS=
# Boîte qui reçoit les messages (défaut : MAIL_USER).
MAIL_RECEIVER=associationenvol13830@gmail.com
# Adresse affichée en expéditeur — Gmail exige le compte authentifié ou un alias.
MAIL_INFO=associationenvol13830@gmail.com
# Préfixe du sujet des e-mails reçus.
CONTACT_FORM_SUBJECT=Message de Envol Culture
